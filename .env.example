# ============================================================
# Pecut AI â€” Environment Variables (EXAMPLE)
# Copy to .env (local) and set real values in your deploy host.
# NEVER commit real secrets. NEVER expose these in frontend code.
# ============================================================

# --- Frontend (safe to expose; VITE_ prefix is bundled client-side) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase Edge Function secrets (server-side only) ---
# Set with: supabase secrets set KEY=value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server ONLY, never in browser

# --- AI providers (server-side only) ---
# Configure only the providers you actually have keys for.
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest

# --- AI request policy ---
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
