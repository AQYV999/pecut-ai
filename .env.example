# ============================================================
# Pecut AI — Environment Variables (Self-Hosted BYOK)
# Copy this file to .env and configure your keys.
# NEVER commit real secrets. Keys are server-only.
# ============================================================

# --- Server Port ---
PORT=3000

# --- Primary AI Provider (Stage 2: Google Gemini) ---
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# --- Additional Providers (Planned) ---
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest

# --- Request Policy ---
AI_REQUEST_TIMEOUT_MS=30000
